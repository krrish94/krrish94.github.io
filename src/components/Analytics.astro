---
// Google Analytics 4. Injected only in production builds (`astro build`),
// never in `astro dev` — no environment-variable plumbing required.
import { SITE } from '../config/site';

const GA_ID = SITE.gaId;
---

{
  import.meta.env.PROD && GA_ID && (
    <Fragment>
      <script
        is:inline
        async
        src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}
      />
      <script is:inline define:vars={{ GA_ID }}>
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          dataLayer.push(arguments);
        }
        gtag('js', new Date());
        gtag('config', GA_ID);
      </script>
    </Fragment>
  )
}
